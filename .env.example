# Configuração do PostgreSQL
POSTGRES_USER=tamburetei_dev
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tamburetei_db
POSTGRES_PORT=5432
POSTGRES_SERVER=db

# Segurança e JWT
SECRET_KEY=sua_chave_secreta_super_segura_unb_2026
# Limite por arquivo de apoio (5 MiB)
MATERIAL_MAX_BYTES=5242880

# pytest no container usa automaticamente ${POSTGRES_DB}_test.
# Para PostgreSQL externo ja provisionado, configure TEST_DATABASE_URL no ambiente de testes.
# Quórum mínimo de doações idênticas para consolidar uma turma (>= 1)
QUORUM_MINIMO_DOACOES=3

# Moderação Autônoma Híbrida via LLM Local (Ollama - ADR 08)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=90.0
MODERATION_CONFIDENCE_THRESHOLD=0.80

# Configuracao de E-mail e SMTP (Tamburetei UnB)
# Deixe em branco em desenvolvimento para usar fallback seguro (sem envio real de e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tambureteiunb@gmail.com
SMTP_PASSWORD=sua_senha_de_app_gerada_no_google
SMTP_FROM_EMAIL=tambureteiunb@gmail.com
SMTP_FROM_NAME="Tamburetei UnB"
SMTP_TLS=true
SMTP_SSL=false
FRONTEND_URL=http://localhost:3000
